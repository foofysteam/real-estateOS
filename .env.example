# Postgres connection string for the app database (required).
DATABASE_URL=postgresql://salesos:salesos@localhost:5432/salesos
# Postgres connection string for the test database (optional; used by db:test:prepare and integration tests).
DATABASE_URL_TEST=postgresql://salesos:salesos@localhost:5432/salesos_test
# Session signing secret, at least 32 characters (required). Generate: openssl rand -hex 32
SESSION_SECRET=
# Field encryption key, exactly 64 hex characters (required). Generate: openssl rand -hex 32
ENCRYPTION_KEY=

# Meta app secret used to verify webhook signatures (optional).
# META_APP_SECRET=
# Token Meta echoes back during webhook subscription verification (optional).
# META_WEBHOOK_VERIFY_TOKEN=
# Meta access token for the Ads MCP / Graph API (optional).
# META_ACCESS_TOKEN=
# Meta Ads MCP server URL (default: https://mcp.facebook.com/ads).
# META_MCP_URL=https://mcp.facebook.com/ads
# JSON object mapping internal operations to MCP tool names (optional).
# META_MCP_TOOL_MAP={}
# Which Meta gateway to use: "mcp" or "graph" (default: mcp).
# META_GATEWAY=mcp
# Graph API version (default: v24.0).
# META_GRAPH_VERSION=v24.0
